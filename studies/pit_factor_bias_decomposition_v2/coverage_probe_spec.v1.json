{
  "schema_version": "stage2_coverage_probe_spec_v1",
  "study_id": "a-share-factor-timing-bias-decomposition-v2",
  "probe_id": "stage2-akshare-raw-coverage-2016-2018-v1",
  "status": "specified_not_executed",
  "purpose": "Outcome-blind feasibility testing of whether a bounded set of Shanghai and Shenzhen A-share raw daily bars can be retrieved for two pre-specified historical dates. This probe is not a factor test, portfolio test, trading simulation, or study outcome analysis.",
  "field_scope_boundary": "This source-retrieval probe deliberately requests a complete raw-bar payload including open and volume. Those two fields are probe-specific diagnostics and possible future portfolio inputs; they are not required inputs or readiness gates for the current Stage-2 IC core, which uses date, symbol, adjusted close, amount, ST state, and suspension state plus separate master, fundamental, and official-calendar inputs.",
  "execution_boundary": {
    "must_not_execute_before_repository_commit": true,
    "required_commit_contents": [
      "studies/pit_factor_bias_decomposition_v2/coverage_probe_spec.v1.json",
      "studies/pit_factor_bias_decomposition_v2/prior_specification_inventory.json"
    ],
    "external_timestamp_required_before_execution": true,
    "authoring_assertion": "This probe was not executed while these two files were authored and MUST NOT be executed before the first repository commit containing both files has been externally timestamped.",
    "prohibited_pre_lock_actions": [
      "requesting any date or symbol outside this specification",
      "inspecting or computing factor values, forward returns, information coefficients, portfolio returns, costs, t-statistics, or rankings",
      "changing the symbols, dates, provider, adjustment mode, or quality thresholds after observing a response",
      "starting a full-market or multi-year extraction"
    ]
  },
  "selection_protocol": {
    "selection_is_outcome_blind": true,
    "selection_input": {
      "logical_source": "current licensed historical stock-master export",
      "sha256": "29b75f0de74c96395bb5d2e311d424cf45a9600a712903c4a96dc9d3d3d26b8b",
      "permitted_selection_fields": [
        "symbol",
        "exchangeCode",
        "listDate",
        "delistDate",
        "listStatus",
        "stockType"
      ],
      "forbidden_selection_fields": "All prices, returns, factors, accounting values, portfolio results, and test statistics."
    },
    "seed": "stage2-coverage-probe-v1",
    "hash_function": "SHA-256",
    "eligibility": [
      "Shanghai or Shenzhen A-share symbol",
      "listDate no later than 2016-01-01",
      "Beijing Stock Exchange excluded"
    ],
    "strata": [
      {
        "id": "early_listed_current",
        "rule": "Within each exchange, take the two earliest-listed securities with no observed delist date and a listed status; break ties by symbol."
      },
      {
        "id": "current_hash_sample",
        "rule": "Within each exchange, exclude the early-listed selections, order remaining currently listed eligible symbols by SHA-256(seed + '|current|' + symbol), and take the first two."
      },
      {
        "id": "delisted_after_2018_hash_sample",
        "rule": "Within each exchange, retain eligible symbols with a delist date on or after 2019-01-01, order by SHA-256(seed + '|delisted|' + symbol), and take the first two. This is a diagnostic survivorship-coverage stratum, not a study universe rule."
      }
    ],
    "symbols": [
      {
