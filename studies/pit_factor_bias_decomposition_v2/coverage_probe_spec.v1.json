    "network_access_when_eventually_executed": true,
    "upstream_provider_identity": "Must be recorded from the runtime response path or adapter metadata; do not infer it solely from the Python package name.",
    "locked_runtime": {
      "qdata_repository_commit": "19b2dd1df8cfbe875809179a4772e4656dce01bd",
      "agent_repository_commit": "COMMIT_CONTAINING_THIS_SPEC",
      "python_version": "3.12.12",
      "akshare_version": "1.18.81",
      "clean_worktrees_required": true
    }
  },
  "storage_and_immutability": {
    "private_output_root": ".research-artifacts/stage2_data_probes/stage2-akshare-raw-coverage-2016-2018-v1",
    "public_raw_rows_allowed": false,
    "fresh_nonexistent_output_directory_required": true,
    "overwrite_allowed": false,
    "resume_from_existing_files_allowed": false,
    "staging_then_atomic_publish_required": true,
    "manifest_written_last": true,
    "file_set_must_be_closed_and_verified": true,
    "file_hash": "SHA-256",
    "canonical_manifest_encoding": "UTF-8 canonical JSON with sorted object keys and no insignificant whitespace",
    "receipt_id_rule": "receipt_id is sha256 of the canonical public receipt with receipt_id omitted",
    "secret_handling": "Do not store credentials, request headers, cookies, absolute private paths, environment values, or unredacted provider errors in either private manifests or the public receipt."
  },
  "pre_execution_gates": [
    {
      "id": "SPEC_COMMITTED",
      "rule": "The first commit containing this specification and the prior-specification inventory exists and is recorded."
    },
    {
      "id": "SPEC_EXTERNALLY_TIMESTAMPED",
      "rule": "The commit or an identical canonical spec hash has an external timestamp before the first request."
    },
    {
      "id": "CODE_STATE_CLEAN_AND_BOUND",
      "rule": "Both repository worktrees are clean and their exact commits and dependency versions are written to the private manifest."
    },
    {
      "id": "OUTPUT_TARGET_NEW",
      "rule": "The private output directory does not exist; any existing target causes a fail-closed stop."
    },
    {
      "id": "RIGHTS_REVIEW_RECORDED",
      "rule": "The source terms, local-storage authorization, and permission to publish aggregate coverage and cryptographic hashes have been reviewed and recorded."
    }
  ],
  "post_collection_quality_gates": [
    {
      "id": "EXACT_REQUEST_SCOPE",
      "rule": "Responses contain no requested date or symbol outside the locked two dates and twelve symbols."
    },
    {
      "id": "COMPLETE_CELL_COVERAGE",
      "rule": "Exactly one normalized daily-bar row exists for every one of the 24 expected symbol-date cells; missing, duplicate, or extra cells fail the probe."
    },
    {
      "id": "PROBE_SPECIFIC_RAW_BAR_FIELDS",
      "rule": "For this bounded source probe only, symbol, trade_date, open, high, low, close, volume, and amount are present and non-null for every observed cell. Open and volume are not IC-core requirements."
    },
    {
      "id": "BASIC_VALUE_INTEGRITY",
      "rule": "OHLC values are finite and positive with low <= open and close <= high; volume and amount are finite and non-negative."
    },
    {
      "id": "RAW_MODE_ATTESTED",
      "rule": "The runtime records an empty AkShare adjustment argument and does not merge qfq, hfq, factor, fundamental, or return fields."
    },
    {
      "id": "FAILURES_ACCOUNTED_FOR",
      "rule": "Every request has a success, empty-response, provider-error, validation-error, or network-error record; errors are redacted before publication."
    },
    {
      "id": "ARTIFACT_HASHES_VERIFIED",
      "rule": "All private raw and normalized artifacts match the SHA-256 values in the closed manifest after collection finishes."
    }
  ],
  "stop_rules": [
    "If any pre-execution gate fails, make no request.",
    "If any post-collection gate fails, record BLOCKED and do not alter the probe scope or thresholds.",
    "An empty row for a delisted security is classified as source-or-adapter ambiguous and cannot establish that historical data do not exist.",
    "No full-market or multi-year acquisition may start from this probe alone.",
    "No claim about executable prices, tradability, suspension, price limits, corporate-action vintages, fundamentals, data revisions, or investment performance is allowed."
  ],
