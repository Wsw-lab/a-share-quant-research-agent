      },
      {
        "symbol": "300367.SZ",
        "exchange": "SZ",
        "stratum": "delisted_after_2018_hash_sample"
      }
    ]
  },
  "request_protocol": {
    "dates": [
      "2016-06-30",
      "2018-06-29"
    ],
    "expected_symbol_date_cells": 24,
    "provider_adapter": "qdata.sources.providers.akshare_provider.AkShareProvider",
